# Connect a Postgres database to this project (Vercel dashboard → Storage →
# Create Database → Postgres, powered by Neon), then run:
#   vercel env pull .env.local
# to pull the real values down. Whichever of these Vercel actually names it,
# api/_db.js and scripts/seed.js check all four.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Connect Blob storage (Vercel dashboard → Storage → Create Database → Blob)
# for PM avatar uploads.
BLOB_READ_WRITE_TOKEN=
