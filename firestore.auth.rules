rules_version = '2';

// SIGN-IN MODE — publish these once ALLOWED_DOMAIN is set in src/lib/auth.js.
// Domain: bhphoto.com. To change it, edit the regex below (keep the backslash before
// each dot), then paste into Firebase console → Firestore → Rules → Publish.
//
// Editors are listed in the document settings/access, field `editors`
// (an array of email addresses). Create/edit that document in the console;
// the app cannot change it.
service cloud.firestore {
  match /databases/{database}/documents {
    // Microsoft sign-in only, with a company email. Firebase doesn't mark
    // Microsoft emails as "verified", so the real gate is the Entra app
    // registration being single-tenant (only bhphoto.com accounts can sign in).
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email.lower().matches('.*@bhphoto\\.com$');
    }

    function isEditor() {
      return signedIn()
        && request.auth.token.email.lower()
           in get(/databases/$(database)/documents/settings/access).data.editors;
    }

    match /settings/access {
      allow read: if signedIn();
      allow write: if false;
    }
    match /initiatives/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }
    match /changes/{id} {
      allow read: if signedIn();
      allow create: if isEditor();
    }
    match /snapshots/{id} {
      allow read: if signedIn();
      allow create: if isEditor();
    }
    match /summaries/{year} {
      allow read: if signedIn();
      allow write: if isEditor();
    }
    match /presets/{id} {
      allow read: if signedIn();
      allow create, delete: if isEditor();
    }
  }
}
