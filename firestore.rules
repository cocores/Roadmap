rules_version = '2';

// OPEN MODE — use while ALLOWED_DOMAIN in src/lib/auth.js is empty.
// Anyone with the app's Firebase config can read and edit the roadmap.
// Once sign-in is turned on, publish firestore.auth.rules instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /initiatives/{id} {
      allow read, write: if true;
    }
    // Change history: append-only.
    match /changes/{id} {
      allow read, create: if true;
    }
    // Saved roadmap snapshots for "Compare": append-only.
    match /snapshots/{id} {
      allow read, create: if true;
    }
    // Stakeholder page: executive summary per year.
    match /summaries/{year} {
      allow read, write: if true;
    }
    // Stakeholder page: saved audience views.
    match /presets/{id} {
      allow read, create, delete: if true;
    }
  }
}
